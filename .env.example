LLM_API_KEY=
LLM_PROVIDER=akashml
LLM_MODEL=Qwen/Qwen3.8-27B
# Fast move feedback; Thorough uses LLM_MODEL.
LLM_MODEL_QUICK=Qwen/Qwen3.6-35B-A3B
# Used for questions and game reviews in Deep Review mode. Moves still use LLM_MODEL.
LLM_MODEL_DEEP=zai-org/GLM-5.3
# Maia-3 runs as an internal CPU sidecar; no credential or exposed port is required.
PORT=4173
# Host-side port used by compose.yaml.
CHESS_COACH_PORT=9123
TZ=America/Los_Angeles
